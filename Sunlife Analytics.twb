      <aliases enabled='yes' />
      <column caption='Book Lapse Rate' datatype='real' name='[Calculation_1994826723663872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED:SUM([lapsed])/count([policy_id])}' />
      </column>
      <column caption='Tenure Band' datatype='string' name='[Calculation_3805997324619776]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [years_active] &lt;=3 then &apos;New (1-3 years)&apos;&#13;&#10;ELSEIF  [years_active] &lt;=7 then &apos;Mid (4-7 years)&apos;&#13;&#10;Else &apos;Mature (8+years)&apos;&#13;&#10;End' />
      </column>
      <column caption='Smoking Status' datatype='string' name='[Calculation_3805997326819329]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [smoker]= 1 then &apos;Smoker&apos;&#13;&#10;else &apos;Non Smoker&apos;&#13;&#10;END' />
      </column>
      <column caption='Average Premium' datatype='real' name='[Calculation_3805997327642626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([premium_monthly])' />
      </column>
      <column caption='Lapse Rate' datatype='real' default-format='p0.00%' name='[Calculation_4075101993607169]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([lapsed])/count([policy_id])' />
      </column>
      <column caption='Retention Rate' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_4075101994438658]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1-[Calculation_4075101993607169]' />
      </column>
      <column caption='Annual Premium at Risk' datatype='real' name='[Calculation_4075101995655171]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [lapsed]=1 then [premium_monthly]*12 end)' />
      </column>
      <column caption='policies' datatype='table' name='[__tableau_internal_object_id__].[policies_20C1B5E892EB4F8A8448E5962E038311]' role='measure' type='quantitative' />
      <column caption='Age' datatype='integer' name='[age]' role='measure' type='quantitative' />
